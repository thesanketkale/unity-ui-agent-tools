{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thesanketkale/unity-ui-agent-tools/main/schema/ui-diff.schema.json",
  "title": "UiDiff",
  "description": "Semantic diff comparison between two UI hierarchy snapshots",
  "type": "object",
  "required": ["targetNameBefore", "targetNameAfter", "timestamp", "changes"],
  "properties": {
    "targetNameBefore": { "type": "string" },
    "targetNameAfter": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "nodeName", "changeType", "description"],
        "properties": {
          "nodeId": { "type": "string" },
          "nodeName": { "type": "string" },
          "changeType": {
            "type": "string",
            "enum": [
              "Added", "Removed", "Moved", "Resized", "TextChanged",
              "ActiveStateChanged", "ComponentAdded", "ComponentRemoved", "ComponentModified"
            ]
          },
          "description": { "type": "string" },
          "beforeValue": { "type": ["string", "null"] },
          "afterValue": { "type": ["string", "null"] }
        }
      }
    }
  }
}
