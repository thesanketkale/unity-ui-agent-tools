{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thesanketkale/unity-ui-agent-tools/main/schema/captures.schema.json",
  "title": "UiCaptures",
  "description": "Metadata descriptor for rendered UI screenshots and bounding-box annotations",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["captureName", "resolution", "rawImagePath", "annotatedImagePath", "annotations"],
    "properties": {
      "captureName": { "type": "string" },
      "resolution": { "type": "string" },
      "rawImagePath": { "type": "string" },
      "annotatedImagePath": { "type": "string" },
      "annotations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["number", "nodeId", "nodeName", "x", "y", "width", "height"],
          "properties": {
            "number": { "type": "integer" },
            "nodeId": { "type": "string" },
            "nodeName": { "type": "string" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      }
    }
  }
}
